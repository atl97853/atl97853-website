---
/**
 * Layout for text-heavy Markdown pages. Markdown frontmatter supplies the
 * page heading and optional browser title and description; BaseLayout owns
 * the document shell and sidebar grid.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import HomeIntro from "@components/homepage/HomeIntro.astro";
import SiteNavigation from "@components/layout/SiteNavigation.astro";
import Panel from "@components/primitives/Panel.astro";
import type { MarkdownLayoutProps } from "astro";

type Props = MarkdownLayoutProps<{
    title: string;
    pageTitle?: string;
    description?: string;
}>;

const { frontmatter } = Astro.props as Props;

const {
    title: panelTitle,
    pageTitle = panelTitle,
    description = panelTitle,
} = frontmatter;
---

<BaseLayout title={pageTitle} description={description}>
    <Panel
        as="article"
        class="nested-markdown-layout"
        title={panelTitle}
        headingLevel="h1"
    >
        <div class="nested-markdown-layout__content">
            <slot />
        </div>
    </Panel>

    <Fragment slot="toolbar">
        <nav class="home-toolbar" aria-label="Breadcrumb">
            <p class="home-toolbar__crumbs">
                <a href="/">atl97853</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">home</span>
            </p>
            <span class="home-toolbar__note">personal webspace · notes &amp; snapshots</span>
        </nav>
    </Fragment>

    <Fragment slot="sidebar">
        <HomeIntro />
        <SiteNavigation />
    </Fragment>
</BaseLayout>

<style>
    .nested-markdown-layout {
        min-width: 0;
        max-width: 100%;
    }

    /* Markdown output is slotted HTML, so its elements need bounded globals. */
    .nested-markdown-layout__content {
        min-width: 0;
        padding: 0.82rem var(--space-md);
        color: var(--text-main);
        font-size: var(--font-md);
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .nested-markdown-layout__content > :global(*:first-child) {
        margin-block-start: 0;
    }

    .nested-markdown-layout__content > :global(*:last-child) {
        margin-block-end: 0;
    }

    .nested-markdown-layout__content :global(p) {
        margin-block: 0 var(--space-md);
        text-wrap: pretty;
    }

    .nested-markdown-layout__content :global(h1),
    .nested-markdown-layout__content :global(h2),
    .nested-markdown-layout__content :global(h3),
    .nested-markdown-layout__content :global(h4),
    .nested-markdown-layout__content :global(h5),
    .nested-markdown-layout__content :global(h6) {
        color: var(--text-strong);
        font-weight: var(--fw-semibold);
        line-height: 1.3;
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    /* The Panel heading is the page h1; Markdown sections start at h2. */
    .nested-markdown-layout__content :global(h1),
    .nested-markdown-layout__content :global(h2) {
        margin: var(--space-lg) 0 var(--space-sm);
        padding-block-end: var(--space-xs);
        border-bottom: var(--border-width) solid var(--border);
        font-size: var(--font-md);
    }

    .nested-markdown-layout__content :global(h3) {
        margin: var(--space-md) 0 var(--space-xs);
        font-size: var(--font-md);
    }

    .nested-markdown-layout__content :global(h4),
    .nested-markdown-layout__content :global(h5),
    .nested-markdown-layout__content :global(h6) {
        margin: var(--space-md) 0 var(--space-xs);
        font-size: var(--font-sm);
    }

    .nested-markdown-layout__content :global(a) {
        color: var(--link-main);
        text-decoration: underline;
        text-decoration-thickness: var(--border-width);
        text-underline-offset: 0.16em;
    }

    .nested-markdown-layout__content :global(a:hover),
    .nested-markdown-layout__content :global(a:focus-visible) {
        text-decoration-thickness: 2px;
    }

    .nested-markdown-layout__content :global(a:focus-visible) {
        outline: 2px solid var(--link-main);
        outline-offset: 2px;
    }

    .nested-markdown-layout__content :global(ul),
    .nested-markdown-layout__content :global(ol) {
        margin-block: 0 var(--space-md);
        padding-inline-start: 1.2rem;
    }

    .nested-markdown-layout__content :global(ul) {
        list-style: disc;
    }

    .nested-markdown-layout__content :global(ol) {
        list-style: decimal;
    }

    .nested-markdown-layout__content :global(li + li) {
        margin-block-start: 0.2rem;
    }

    .nested-markdown-layout__content :global(li > ul),
    .nested-markdown-layout__content :global(li > ol) {
        margin-block: var(--space-xs) 0;
    }

    .nested-markdown-layout__content :global(blockquote) {
        margin: var(--space-md) 0;
        padding: var(--space-sm) var(--space-md);
        border-inline-start: 3px solid var(--link-main);
        background: var(--surface-soft);
        color: var(--text-muted);
    }

    .nested-markdown-layout__content :global(blockquote > :last-child) {
        margin-block-end: 0;
    }

    .nested-markdown-layout__content :global(img) {
        display: block;
        box-sizing: border-box;
        max-width: 100%;
        height: auto;
        margin: var(--space-md) auto;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius);
    }

    .nested-markdown-layout__content :global(figure) {
        margin: var(--space-md) 0;
    }

    .nested-markdown-layout__content :global(figure img) {
        margin-block: 0;
    }

    .nested-markdown-layout__content :global(figcaption) {
        margin-block-start: var(--space-xs);
        color: var(--text-muted);
        font-size: var(--font-sm);
        line-height: var(--line-height-reading);
    }

    .nested-markdown-layout__content :global(iframe),
    .nested-markdown-layout__content :global(video),
    .nested-markdown-layout__content :global(embed),
    .nested-markdown-layout__content :global(object) {
        width: 100%;
        max-width: 100%;
    }

    .nested-markdown-layout__content :global(iframe) {
        height: auto;
        aspect-ratio: 16 / 9;
    }

    .nested-markdown-layout__content :global(code) {
        padding: 0.1rem 0.3rem;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius);
        background: var(--surface-soft);
        color: var(--text-strong);
        font-family: var(--font-mono, ui-monospace, Consolas, monospace);
        font-size: 0.9em;
        font-variant-ligatures: none;
        overflow-wrap: anywhere;
    }

    .nested-markdown-layout__content :global(pre) {
        box-sizing: border-box;
        max-width: 100%;
        margin: var(--space-md) 0;
        padding: var(--space-md);
        overflow-x: auto;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius);
        background: var(--surface-soft);
        color: var(--text-main);
        tab-size: 4;
        white-space: pre;
        -webkit-overflow-scrolling: touch;
    }

    .nested-markdown-layout__content :global(pre code) {
        display: block;
        min-width: max-content;
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        color: inherit;
        font-size: var(--font-sm);
        line-height: 1.6;
        overflow-wrap: normal;
        white-space: inherit;
    }

    .nested-markdown-layout__content :global(table) {
        display: block;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        margin: var(--space-md) 0;
        overflow-x: auto;
        border-collapse: collapse;
        -webkit-overflow-scrolling: touch;
    }

    .nested-markdown-layout__content :global(th),
    .nested-markdown-layout__content :global(td) {
        padding: var(--space-xs) var(--space-sm);
        border: var(--border-width) solid var(--border);
        text-align: start;
        vertical-align: top;
    }

    .nested-markdown-layout__content :global(th) {
        background: var(--surface-soft);
        color: var(--text-strong);
        font-weight: var(--fw-semibold);
    }

    .nested-markdown-layout__content :global(hr) {
        height: 0;
        margin: var(--space-lg) 0;
        border: 0;
        border-top: var(--border-width) solid var(--border);
    }

    .nested-markdown-layout__content :global(.katex-display),
    .nested-markdown-layout__content :global(.math-display),
    .nested-markdown-layout__content :global(mjx-container[display="true"]) {
        max-width: 100%;
        padding-block: var(--space-xs);
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

    .home-toolbar {
        display: flex;
        min-width: 0;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        padding: 0.55rem var(--space-md);
        color: var(--text-muted);
        font-size: var(--font-xs);
    }

    .home-toolbar__crumbs {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        min-width: 0;
        margin: 0;
        color: var(--text-strong);
        font-family: var(--font-mono);
        font-size: var(--font-xs);
        font-weight: var(--fw-semibold);
    }

    .home-toolbar__crumbs a {
        color: var(--link-main);
        text-decoration: none;
    }

    .home-toolbar__note {
        font-family: var(--font-mono);
        font-size: var(--font-2xs);
        text-align: end;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    @media (max-width: 32rem) {
        .home-toolbar__note {
            display: none;
        }
    }

    @media (max-width: 38rem) {
        .nested-markdown-layout__content {
            padding-inline: var(--space-sm);
        }

        .nested-markdown-layout__content :global(ul),
        .nested-markdown-layout__content :global(ol) {
            padding-inline-start: 1.1rem;
        }

        .nested-markdown-layout__content :global(pre) {
            padding: var(--space-sm);
        }

        .nested-markdown-layout__content :global(th),
        .nested-markdown-layout__content :global(td) {
            padding: var(--space-xs);
        }
    }
</style>