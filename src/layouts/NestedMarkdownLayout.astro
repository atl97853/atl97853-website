---
/**
 * Nested layout for text-heavy Markdown pages in `src/pages`.
 *
 * Markdown pages select this layout through their special `layout`
 * frontmatter property. Astro provides the page metadata through
 * `Astro.props.frontmatter` and inserts the rendered Markdown body into
 * the default `<slot />`.
 *
 * BaseLayout provides the document shell. This layout adds the content
 * Panel and SiteNavigation sidebar.
 */
import BaseLayout from "@layouts/BaseLayout.astro";

import SiteNavigation from "@components/layout/SiteNavigation.astro";
import Panel from "@components/primitives/Panel.astro";

import type { MarkdownLayoutProps } from "astro";

type Props = MarkdownLayoutProps<{
    /** Heading displayed at the top of the page panel. */
    title: string;

    /** Optional browser-tab title. Defaults to `title`. */
    pageTitle?: string;

    /** Optional meta description. Defaults to `title`. */
    description?: string;
}>;

const { frontmatter } = Astro.props as Props;

const {
    title: panelTitle,
    pageTitle = panelTitle,
    description = panelTitle,
} = frontmatter;
---

<BaseLayout
    title={pageTitle}
    description={description}
>
    <Panel
        as="article"
        class="nested-markdown-layout"
        title={panelTitle}
        headingLevel="h1"
    >
        {/*
            * Astro replaces `<slot />` with the HTML generated from the Markdown body.
            * It converts the Markdown body into HTML and passes that HTML as the layout’s default slot.
            * You do not see an explicit component invocation because Astro creates that relationship from the Markdown file’s layout property.
            * The wrapper provides a local styling boundary for that generated HTML.
        */}
        <div class="nested-markdown-layout__content">
            <slot />
        </div>
    </Panel>

    <SiteNavigation slot="sidebar" />
</BaseLayout>

{/*
    * Your narrow use of :global(.panel__heading) is correct. 
    * The scoped .markdown-page parent prevents it from affecting every Panel. 
    * If you later style generated Markdown elements, use similarly bounded 
    * selectors.
 */}
<style>
    /* Scoped Panel override */
    .nested-markdown-layout {
        /* Prevent wide Markdown content from expanding the layout column. */
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }

    .nested-markdown-layout > :global(.panel__heading) {
        padding: 0.82rem var(--space-md);
        border-bottom: 1px solid var(--border);
    }
    /* Scoped Panel override */

    /*
     * Markdown is rendered as slotted HTML, so its elements do not receive
     * this component's Astro scope attribute. Bounded :global() selectors
     * allow us to style them without affecting Markdown elsewhere.
     * Constrain the outer panel and content.
     */
    .nested-markdown-layout__content {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        padding: 0.82rem var(--space-md);
        color: var(--text-main);
        font-size: var(--font-md);
        /*
         * !!! Core reading rhythm.
         * This controls spacing between lines within the same paragraph.
         */
        line-height: 1.4;
        overflow-wrap: anywhere;
    }
  /* Remove unwanted space at the beginning and end of the Markdown body. */
    .nested-markdown-layout__content > :global(*:first-child) {
        margin-top: 0;
    }

    .nested-markdown-layout__content > :global(*:last-child) {
        margin-bottom: 0;
    }

    /*
     * !!! Core paragraph rhythm.
     * Blank lines in Markdown create separate <p> elements, and this margin
     * creates the visible space between those paragraphs.
     */
    .nested-markdown-layout__content :global(p) {
        margin-top: 0;
        margin-bottom: var(--space-md);
        text-wrap: pretty;
    }

    /* Shared typography for headings generated from Markdown. */
    .nested-markdown-layout__content :global(h1),
    .nested-markdown-layout__content :global(h2),
    .nested-markdown-layout__content :global(h3),
    .nested-markdown-layout__content :global(h4),
    .nested-markdown-layout__content :global(h5),
    .nested-markdown-layout__content :global(h6) {
        color: var(--text-strong);
        font-weight: var(--fw-semibold);
        line-height: 1.3;
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    /*
     * The Panel heading is already the page-level h1. Markdown content should
     * generally begin with h2, but h1 is styled defensively in case one is used.
     */
    .nested-markdown-layout__content :global(h1),
    .nested-markdown-layout__content :global(h2) {
        margin: var(--space-lg) 0 var(--space-sm);
        padding-bottom: var(--space-xs);
        font-size: var(--font-md);
        border-bottom: 1px solid var(--border);
    }

    .nested-markdown-layout__content :global(h3) {
        margin: var(--space-md) 0 var(--space-xs);
        font-size: var(--font-md);
    }

    .nested-markdown-layout__content :global(h4),
    .nested-markdown-layout__content :global(h5),
    .nested-markdown-layout__content :global(h6) {
        margin: var(--space-md) 0 var(--space-xs);
        font-size: var(--font-sm);
    }

    /* Keep links recognizable while increasing emphasis on interaction. */
    .nested-markdown-layout__content :global(a) {
        color: var(--link-main);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
    }

    .nested-markdown-layout__content :global(a:hover),
    .nested-markdown-layout__content :global(a:focus-visible) {
        text-decoration-thickness: 2px;
    }

    .nested-markdown-layout__content :global(a:focus-visible) {
        outline: 2px solid var(--link-main);
        outline-offset: 2px;
    }

    /* Restore predictable Markdown list spacing and marker styles. */
    .nested-markdown-layout__content :global(ul),
    .nested-markdown-layout__content :global(ol) {
        margin-top: 0;
        margin-bottom: var(--space-md);
        padding-inline-start: 1.2rem;
    }

    .nested-markdown-layout__content :global(ul) {
        list-style: disc;
    }

    .nested-markdown-layout__content :global(ol) {
        list-style: decimal;
    }

    .nested-markdown-layout__content :global(li + li) {
        margin-top: 0.2rem;
    }

    .nested-markdown-layout__content :global(li > ul),
    .nested-markdown-layout__content :global(li > ol) {
        margin-top: var(--space-xs);
        margin-bottom: 0;
    }

    /* Blockquotes remain visually distinct without becoming a second card. */
    .nested-markdown-layout__content :global(blockquote) {
        margin: var(--space-md) 0;
        padding-inline-start: var(--space-sm);
        color: var(--text-muted);
        border-inline-start: 2px solid var(--border);
    }

    .nested-markdown-layout__content :global(blockquote > *:last-child) {
        margin-bottom: 0;
    }

    /*
     * Images and figures stay within the available content column while
     * retaining their natural aspect ratio.
     */
    .nested-markdown-layout__content :global(img) {
        display: block;
        box-sizing: border-box;
        max-width: 100%;
        height: auto;
        margin: var(--space-md) auto;
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .nested-markdown-layout__content :global(figure) {
        margin: var(--space-md) 0;
    }

    .nested-markdown-layout__content :global(figure img) {
        margin-block: 0;
    }

    .nested-markdown-layout__content :global(figcaption) {
        margin-top: var(--space-xs);
        color: var(--text-muted);
        font-size: var(--font-sm);
        line-height: var(--line-height-reading);
    }

    /*
     * Responsive embeds use their available column width. The aspect ratio
     * gives iframe-based media a stable height when the source omits one.
     */
    .nested-markdown-layout__content :global(iframe),
    .nested-markdown-layout__content :global(video),
    .nested-markdown-layout__content :global(embed),
    .nested-markdown-layout__content :global(object) {
        width: 100%;
        max-width: 100%;
    }

    .nested-markdown-layout__content :global(iframe) {
        aspect-ratio: 16 / 9;
        height: auto;
    }

    /* Inline code receives a compact visual treatment within prose. */
    .nested-markdown-layout__content :global(code) {
        padding: 0.1rem 0.3rem;
        overflow-wrap: anywhere;
        word-break: break-word;
        color: var(--text-strong);
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-family:
            var(
                --font-mono,
                ui-monospace,
                SFMono-Regular,
                Consolas,
                "Liberation Mono",
                monospace
            );
        font-size: 0.9em;
        font-variant-ligatures: none;
    }

    /*
     * Fenced blocks preserve whitespace so they can display source code
     * and simple ASCII art without losing character alignment.
     */
    .nested-markdown-layout__content :global(pre) {
        box-sizing: border-box;
        max-width: 100%;
        margin: var(--space-md) 0;
        padding: var(--space-md);
        overflow-x: auto;
        overflow-wrap: normal;
        color: var(--text-main);
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        tab-size: 4;
        white-space: pre;
        -webkit-overflow-scrolling: touch;
    }

    /*
     * Reset the inline-code appearance when code is nested inside a fenced
     * block. The surrounding <pre> owns the block surface.
     */
    .nested-markdown-layout__content :global(pre code) {
        display: block;
        min-width: max-content;
        padding: 0;
        color: inherit;
        background: transparent;
        border: 0;
        border-radius: 0;
        font-size: var(--font-sm);
        line-height: 1.6;
        overflow-wrap: normal;
        word-break: normal;
        white-space: inherit;
    }

    /*
     * Wide tables remain inside the Panel and scroll horizontally instead of
     * forcing the main layout column to expand.
     */
    .nested-markdown-layout__content :global(table) {
        display: block;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        margin: var(--space-md) 0;
        overflow-x: auto;
        border-collapse: collapse;
        -webkit-overflow-scrolling: touch;
    }

    .nested-markdown-layout__content :global(th),
    .nested-markdown-layout__content :global(td) {
        padding: var(--space-xs) var(--space-sm);
        border: 1px solid var(--border);
        text-align: start;
        vertical-align: top;
    }

    .nested-markdown-layout__content :global(th) {
        color: var(--text-strong);
        font-weight: var(--fw-semibold);
        background: var(--surface-hover);
    }

    .nested-markdown-layout__content :global(hr) {
        height: 0;
        margin: var(--space-lg) 0;
        border: 0;
        border-top: 1px solid var(--border);
    }

    .nested-markdown-layout__content :global(.katex-display),
    .nested-markdown-layout__content :global(.math-display),
    .nested-markdown-layout__content :global(mjx-container[display="true"]) {
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        padding-block: var(--space-xs);
        -webkit-overflow-scrolling: touch;
    }

    /* Reduce indentation and block padding on narrow screens. */
    @media (max-width: 38rem) {
        .nested-markdown-layout > :global(.panel__heading),
        .nested-markdown-layout__content {
            padding-inline: var(--space-sm);
        }

        .nested-markdown-layout__content :global(ul),
        .nested-markdown-layout__content :global(ol) {
            padding-inline-start: 1.1rem;
        }

        .nested-markdown-layout__content :global(pre) {
            padding: var(--space-sm);
        }

        .nested-markdown-layout__content :global(th),
        .nested-markdown-layout__content :global(td) {
            padding: var(--space-xs);
        }
    }
</style>