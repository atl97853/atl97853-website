{/*
 * BaseLayout applies the saved or system theme before the first paint.
 * This component handles theme changes, persists the selection, and
 * synchronizes the buttons' aria-pressed states when it initializes.
 */}
<script>
    const STORAGE_KEY = "site-theme";

    type Theme = "dark" | "light";

    function isTheme(value: string | undefined): value is Theme {
        return value === "dark" || value === "light";
    }

    class ThemeControlsElement extends HTMLElement {
        private handleClick = (event: Event) => {
            const target = event.target;

            if (!(target instanceof Element)) return;

            const button = target.closest<HTMLButtonElement>(
                "[data-theme-value]",
            );

            const theme = button?.dataset.themeValue;

            if (!isTheme(theme)) return;

            this.setTheme(theme);
        };

        connectedCallback() {
            this.addEventListener("click", this.handleClick);

            const theme = document.documentElement.dataset.theme;

            this.sync(isTheme(theme) ? theme : "dark");
        }

        disconnectedCallback() {
            this.removeEventListener("click", this.handleClick);
        }

        private setTheme(theme: Theme) {
            document.documentElement.dataset.theme = theme;
            this.sync(theme);

            try {
                localStorage.setItem(STORAGE_KEY, theme);
            } catch {
                // The selected theme still works for the current page.
            }
        }

        private sync(theme: Theme) {
            this.querySelectorAll<HTMLButtonElement>(
                "[data-theme-value]",
            ).forEach((button) => {
                button.setAttribute(
                    "aria-pressed",
                    String(button.dataset.themeValue === theme),
                );
            });
        }
    }

    if (!customElements.get("theme-controls")) {
        customElements.define(
            "theme-controls",
            ThemeControlsElement,
        );
    }
</script>

<style>
    .theme-controls {
        display: flex;
        justify-self: end;
        align-items: center;
        gap: 2px;
        padding: 4px;
        border-radius: 5px;
        background: rgb(20 27 59 / 22%);
    }

    .theme-control {
        display: inline-grid;
        width: 2rem;
        height: 2rem;
        place-items: center;
        border: 0;
        border-radius: 4px;
        background: transparent;
        color: #e5e8f4;
        cursor: pointer;
        text-decoration: none;
    }

    .theme-control svg {
        width: 1rem;
        height: 1rem;
    }

    /*
    * Apply hover feedback only to controls that are not currently selected.
    */
    .theme-control:not([aria-pressed="true"]):hover {
        background: rgb(255 255 255 / 16%);
        color: #ffffff;
    }

    :global(html[data-theme="dark"]) .theme-control[data-theme-value="dark"],
    :global(html[data-theme="light"]) .theme-control[data-theme-value="light"] {
        background: #e7e9f2;
        color: #394572;
        box-shadow:
            inset 1px 1px 0 rgb(255 255 255 / 70%),
            inset -1px -1px 0 rgb(25 31 66 / 35%);
    }

    :global(html[data-theme="dark"])
        .theme-control[data-theme-value="dark"]:hover,
    :global(html[data-theme="light"])
        .theme-control[data-theme-value="light"]:hover {
        background: #e7e9f2;
        color: #394572;
    }

    .theme-control:focus-visible {
        outline: 2px solid #ffffff;
        outline-offset: 1px;
    }
</style>
