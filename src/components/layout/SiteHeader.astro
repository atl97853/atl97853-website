---
import { Image } from "astro:assets";
import bannerImg from "@images/assets/banner_img.jpg";

import ThemeControls from "./ThemeControls.astro";
---

<header class="site-header">
    <div class="site-header__toolbar">
        <a class="site-header__identity" href="/">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                    fill="currentColor"
                    d="M3 10.5 12 3l9 7.5v9A1.5 1.5 0 0 1 19.5 21H15v-6H9v6H4.5A1.5 1.5 0 0 1 3 19.5v-9Z"
                />
            </svg>
            <span>atl97853</span>
        </a>

        <ThemeControls />
        
    </div>

    <div class="site-header__banner">
        <Image
            class="site-header__banner-image"
            src={bannerImg}
            alt=""
            priority
        />
    </div>
</header>

<style>
    .site-header__toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        min-height: var(--site-toolbar-min-height);
        align-items: center;
        gap: var(--space-md);
        margin-inline: calc(var(--site-gutter) * -1);
        margin-bottom: var(--space-lg);
        padding: var(--space-xs) var(--site-gutter);

        /*
         * The shared tokens preserve the reference gradient across themes.
         * Only the controls' hover accent follows the active theme palette.
         */
        border-bottom: var(--border-width) solid var(--site-toolbar-border);
        background: var(--site-toolbar-background);
        box-shadow: var(--site-toolbar-shadow);
    }

    .site-header__identity {
        display: inline-flex;
        width: max-content;
        align-items: center;
        gap: var(--space-sm);
        color: var(--site-toolbar-text);
        font-size: var(--font-md);
        font-weight: var(--fw-bold);
        text-decoration: none;
    }

    .site-header__identity:visited {
        color: var(--site-toolbar-text);
    }

    .site-header__identity:hover {
        color: var(--link-hover-site-header);
    }

    .site-header__identity svg {
        width: var(--site-toolbar-icon-size);
        height: var(--site-toolbar-icon-size);
    }

    .site-header__banner {
        margin: var(--space-none) var(--space-none) var(--space-lg);
        overflow: hidden;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius);
        background: var(--card-bg);
        /* box-shadow: var(--shadow); */
    }

    .site-header__banner-image {
        width: 100%;
        height: var(--site-banner-height);
        object-fit: cover;
    }

    /*
     * CSS custom properties cannot be used in media-query conditions, so the
     * compact breakpoint remains explicit while its visual value is tokenized.
     */
    @media (max-width: 38rem) {
        .site-header__banner-image {
            height: var(--site-banner-compact-height);
        }
    }
</style>
