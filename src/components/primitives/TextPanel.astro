---
import Panel from "@components/primitives/Panel.astro";

type ContainerTag =
    | "section"
    | "article"
    | "aside"
    | "nav"
    | "div";

interface Props {
    as?: ContainerTag;
    title?: string;
}

const {
    as = "section",
    title,
} = Astro.props;
---

<Panel
    as={as}
    class="text-container"
    title={title}
>
    <div class="text-container__body">
        <slot />
    </div>
</Panel>