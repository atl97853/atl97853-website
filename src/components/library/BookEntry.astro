---
import type { CollectionEntry } from "astro:content";

import Card from "./primitives/Card.astro";
import SpoilerImage from "./SpoilerImage.astro";

interface Props {
    book: CollectionEntry<"library">;
}

const { book } = Astro.props;

const {
    title,
    author,
    pubYear,
    status,
    rating,
    cover,
    coverAlt,
    coverHasSpoiler,
    tags = [],
    summary,
} = book.data;

const { Content } = await book.render();

const bookTitleId = `library-book-${book.slug.replace(/[^a-zA-Z0-9_-]/g, "-")}`;

const coverSrc =
    typeof cover === "string" && cover.trim().length > 0 ? cover : null;

const hasCover = coverSrc !== null;
const hasRating = typeof rating === "number";
const hasNotes = typeof book.body === "string" && book.body.trim().length > 0;
const hasSummary = typeof summary === "string" && summary.trim().length > 0;

const bookBodyClass = hasCover
    ? "c-library-book__body"
    : "c-library-book__body c-library-book__body--no-cover";

function clampRating(value: number): number {
    return Math.min(5, Math.max(0, value));
}

function formatRating(value: number): string {
    const safeValue = clampRating(value);

    return Number.isInteger(safeValue) ? `${safeValue}` : safeValue.toFixed(1);
}

function renderStars(value?: number): string {
    if (typeof value !== "number") {
        return "unrated";
    }

    const roundedValue = Math.round(clampRating(value));
    const emptyStars = 5 - roundedValue;

    return `${"★".repeat(roundedValue)}${"☆".repeat(emptyStars)}`;
}
---

<Card
    as="article"
    class="c-library-book"
    bodyClass={bookBodyClass}
    ariaLabel={`Book: ${title}`}
>
    {
        coverSrc && (
            <div class="c-library-book__cover">
                <SpoilerImage
                    src={coverSrc}
                    alt={coverAlt || `Cover image for ${title}`}
                    spoiler={coverHasSpoiler}
                />
            </div>
        )
    }

    <div class="c-library-book__content">
        <header>
            <p class="c-library-book__meta">
                {status}
                {pubYear && ` · ${pubYear}`}
            </p>

            <h2 id={bookTitleId} class="c-library-book__title">
                {title}
            </h2>

            <p class="c-library-book__author">
                by {author}
            </p>
        </header>

        {
            hasSummary && (
                <p class="c-library-book__summary">
                    {summary}
                </p>
            )
        }

        <div
            class="c-library-book__rating"
            aria-label={
                hasRating ? `${formatRating(rating)} out of 5 stars` : "unrated"
            }
        >
            <span aria-hidden="true">{renderStars(rating)}</span>

            {
                hasRating && (
                    <span class="c-library-book__rating-value">
                        {formatRating(rating)} / 5
                    </span>
                )
            }
        </div>

        {
            tags.length > 0 && (
                <ul class="c-library-book__tags" aria-label="Book tags">
                    {tags.map((tag) => (
                        <li class="c-library-book__tag">{tag}</li>
                    ))}
                </ul>
            )
        }

        {
            hasNotes && (
                <details class="c-library-book__notes">
                    <summary class="c-library-book__notes-summary">
                        <span class="c-library-book__notes-closed">
                            reading notes
                        </span>

                        <span class="c-library-book__notes-open">
                            hide notes
                        </span>
                    </summary>

                    <div class="c-library-book__notes-content">
                        <Content />
                    </div>
                </details>
            )
        }
    </div>
</Card>

<style>
    :global(.c-library-book) {
        margin-bottom: var(--space-none);
        background: transparent;
        border: 0;
        border-radius: var(--br-sm);
    }

    :global(.c-library-book__body) {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr);
        gap: var(--space-md);
        padding: var(--space-md) var(--space-none);
        border-bottom: var(--bw-frame) solid
            var(--library-border, var(--clr-border));
    }

    :global(.c-library-book__body--no-cover) {
        grid-template-columns: 1fr;
    }

    .c-library-book__cover {
        width: 100%;
        max-width: 120px;
        aspect-ratio: 2 / 3;
        min-width: 0;
        overflow: hidden;
    }

    .c-library-book__cover :global(.c-spoiler-image),
    .c-library-book__cover :global(.c-spoiler-image__media) {
        width: 100%;
        height: 100%;
    }

    .c-library-book__content {
        min-width: 0;
    }

    .c-library-book__meta {
        margin: var(--space-none) var(--space-none) var(--space-xs);
        color: var(--clr-text-muted);
        font-size: var(--fs-xs);
        line-height: 1.4;
    }

    .c-library-book__title {
        margin: var(--space-none);
        color: var(--clr-text-main);
        font-size: var(--fs-sm);
        line-height: 1.35;
        font-weight: var(--fw-bold);
        overflow-wrap: anywhere;
    }

    .c-library-book__author {
        margin: 2px var(--space-none) var(--space-none);
        color: var(--clr-text-muted);
        font-size: var(--fs-sm);
        line-height: 1.35;
        overflow-wrap: break-word;
    }

    .c-library-book__summary {
        margin: var(--space-sm) var(--space-none) var(--space-none);
        color: var(--clr-text-main);
        font-size: var(--fs-sm);
        line-height: var(--lh-text);
        overflow-wrap: break-word;
    }

    .c-library-book__rating {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-xs);
        margin-top: var(--space-xs);
        color: var(--library-star, var(--clr-accent));
        font-size: var(--fs-sm);
        line-height: 1.4;
        letter-spacing: 0.03em;
    }

    .c-library-book__rating-value {
        color: var(--clr-text-muted);
        font-size: var(--fs-xs);
        letter-spacing: 0;
    }

    .c-library-book__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin: var(--space-sm) var(--space-none) var(--space-none);
        padding: var(--space-none);
        list-style: none;
    }

    .c-library-book__tag {
        padding: 0.1rem 0.45rem;
        color: var(--clr-text-main);
        background: var(--library-tag-bg, transparent);
        border: var(--bw-frame) solid var(--library-border, var(--clr-border));
        font-size: var(--fs-xs);
        line-height: 1.35;
    }

    .c-library-book__notes {
        margin-top: var(--space-sm);
    }

    .c-library-book__notes-summary {
        display: inline-block;
        color: var(--clr-accent);
        font-size: var(--fs-sm);
        line-height: 1.4;
        text-decoration: underline;
        text-underline-offset: 0.14em;
        cursor: pointer;
        list-style: none;
    }

    .c-library-book__notes-summary::-webkit-details-marker {
        display: none;
    }

    .c-library-book__notes-summary::marker {
        content: "";
    }

    .c-library-book__notes-summary:hover,
    .c-library-book__notes-summary:focus-visible {
        color: var(--clr-link-hover);
    }

    .c-library-book__notes-summary:focus-visible {
        outline: var(--bw-frame) solid currentColor;
        outline-offset: 2px;
    }

    .c-library-book__notes-open {
        display: none;
    }

    .c-library-book__notes[open] .c-library-book__notes-closed {
        display: none;
    }

    .c-library-book__notes[open] .c-library-book__notes-open {
        display: inline;
    }

    .c-library-book__notes-content {
        margin-top: var(--space-sm);
        color: var(--clr-text-main);
        font-size: var(--fs-sm);
        line-height: 1.6;
        overflow-wrap: break-word;
    }

    .c-library-book__notes-content > *:first-child {
        margin-top: var(--space-none);
    }

    .c-library-book__notes-content > *:last-child {
        margin-bottom: var(--space-none);
    }

    @media (max-width: 38em) {
        :global(.c-library-book__body) {
            grid-template-columns: 1fr;
        }

        .c-library-book__cover {
            max-width: 120px;
        }
    }
</style>