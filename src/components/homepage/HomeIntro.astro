---
import { Image } from "astro:assets";
import avatar from "@images/assets/02_avatar_image.jpg";

import Panel from "@components/primitives/Panel.astro";

const title = "About the webmaster";
---

<Panel as="section" class="home-intro" title={title}>
    <div class="home-intro__layout">
        <Image
            class="home-intro__avatar"
            src={avatar}
            alt="Personal profile image"
            width={150}
            height={150}
            densities={[1.5, 2]}
            priority
        />

        <p class="home-intro__description">
            Hi ヾ(・ω・*), my name is <strong>Atl</strong>. I am a Computer Systems
            Engineering student at TecNM, and this is my personal website. Feel
            free to wander around.
        </p>
    </div>
</Panel>

<style>
    /*
     * This component-specific measurement mirrors the intrinsic Image
     * dimensions above and keeps the repeated CSS dimensions synchronized.
     */
    .home-intro__layout {
        display: grid;
        justify-items: start;
        gap: var(--space-md);
        padding: var(--space-md);
    }

    .home-intro__avatar {
        max-width: 10rem;
        aspect-ratio: 1;
        border: var(--border-width) solid var(--border-strong);
        border-radius: var(--radius);
        background: var(--surface-soft);
        object-fit: cover;
        justify-self: center;
    }

    .home-intro__description {
        max-width: var(--reading-width);
        font-size: var(--font-md);
        line-height: 1.45;
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }
</style>
