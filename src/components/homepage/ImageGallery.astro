---
/**
 * Displays up to four recent images defined in a JSON file.
 *
 * Each JSON entry contains only editorial data (`src`, `alt`, and
 * `description`). Image dimensions and optimized output URLs come from the
 * corresponding local asset imported through Vite below.
 */

import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";

import Panel from "@components/primitives/Panel.astro";

// The JSON controls which images appear and supplies their text. Its `src`
// values must exactly match keys generated by the Vite glob below.
import recentImages from "@content/gallery/recent_images.json";

interface GalleryImage {
    src?: string;
    alt?: string;
    description?: string;
}

interface NormalizedGalleryImage {
    asset: ImageMetadata;
    expandedSrc: string;
    expandedSrcset: string;
    expandedSizes: string;
    expandedWidth: number;
    expandedHeight: number;
    alt: string;
    description: string;
}

interface ResolvedGalleryImage {
    loadAsset: () => Promise<{ default: ImageMetadata }>;
    alt: string;
    description: string;
}

const IMAGE_LIMIT = 4;

/*
 * Thumbnail candidates cover the gallery's real desktop column width at common
 * display densities. Astro ignores widths larger than an original asset, so
 * this list improves sharpness without creating artificial upscales.
 */
const THUMBNAIL_WIDTHS = [240, 360, 480, 640, 720, 960, 1200];

const THUMBNAIL_SIZES = ["(max-width: 25rem) calc(100vw - 1rem)", "17rem"].join(
    ", ",
);

/*
 * Expanded images receive a responsive source set rather than one fixed file.
 * The maximum prevents very large originals from producing unnecessarily heavy
 * dialog assets while still providing enough detail for high-density screens.
 */
const EXPANDED_IMAGE_WIDTHS = [720, 960, 1280, 1600, 1920, 2560];
const EXPANDED_IMAGE_MAX_WIDTH = 2560;
const EXPANDED_IMAGE_SIZES = "(max-width: 60rem) 92vw, 80rem";

const imageEntries = recentImages satisfies GalleryImage[];

/*
 * Vite discovers every supported image stored directly in `src/images/gallery`.
 * JSON must use the resulting source-relative key, for example:
 * `/src/images/gallery/01-kindle-dinner.jpeg`.
 *
 * The glob returns lazy import functions. Only the valid entries selected for
 * this gallery are imported, allowing Astro to infer their dimensions and
 * generate optimized files without eagerly importing the entire directory.
 */
const galleryAssets = import.meta.glob<{ default: ImageMetadata }>(
    "/src/images/gallery/*.{avif,gif,jpeg,jpg,png,webp}",
);

/**
 * Validates one JSON entry and connects its `src` key to the matching Vite
 * asset loader. Incomplete editorial entries are omitted; an unresolved file
 * path throws because it represents a configuration error rather than content
 * that should silently disappear.
 */
function resolveImage(image: GalleryImage): ResolvedGalleryImage | null {
    const src = image.src?.trim() ?? "";
    const alt = image.alt?.trim() ?? "";
    const description = image.description?.trim() ?? "";
    const loadAsset = galleryAssets[src];

    if (!src || !alt || !description) return null;

    // A missing asset indicates a typo or a mismatch between the JSON path
    // and the glob above. Fail during development/build instead of silently
    // removing the entry and rendering an apparently empty gallery.
    if (!loadAsset) {
        throw new Error(`RecentImages could not resolve image: ${src}`);
    }

    return { loadAsset, alt, description };
}

/**
 * Imports one local asset and creates responsive dialog renditions.
 *
 * Every requested width is bounded by the original file. This avoids stretching
 * a small source beyond its real resolution while allowing large sources to
 * remain sharp on high-density displays.
 */
async function prepareImage(
    image: ResolvedGalleryImage,
): Promise<NormalizedGalleryImage> {
    const asset = (await image.loadAsset()).default;

    const expandedWidth = Math.min(asset.width, EXPANDED_IMAGE_MAX_WIDTH);

    const expandedHeight = Math.round(
        asset.height * (expandedWidth / asset.width),
    );

    /*
     * Always include the bounded fallback width. This guarantees at least one
     * valid candidate even when the original is smaller than every preset.
     */
    const expandedWidths = [
        ...EXPANDED_IMAGE_WIDTHS.filter((width) => width < expandedWidth),
        expandedWidth,
    ].filter((width, index, widths) => widths.indexOf(width) === index);

    const expandedImage = await getImage({
        src: asset,
        widths: expandedWidths,
        sizes: EXPANDED_IMAGE_SIZES,
        quality: "max",
    });

    return {
        asset,
        expandedSrc: expandedImage.src,
        expandedSrcset: expandedImage.srcSet.attribute,
        expandedSizes: EXPANDED_IMAGE_SIZES,
        expandedWidth,
        expandedHeight,
        alt: image.alt,
        description: image.description,
    };
}

// Validate before applying the limit so an incomplete early entry does not
// prevent a later valid image from being displayed.
const resolvedImages = imageEntries
    .map(resolveImage)
    .filter((image): image is ResolvedGalleryImage => image !== null)
    .slice(0, IMAGE_LIMIT);

// Resolve only the selected asset modules. `ImageMetadata` supplies intrinsic
// thumbnail dimensions, while `prepareImage` creates a responsive source set
// for the dialog instead of serving one undersized rendition everywhere.
const images: NormalizedGalleryImage[] = await Promise.all(
    resolvedImages.map(prepareImage),
);
---

{
    /*
     * Panel provides the shared outer shell and heading. The custom element keeps
     * all gallery interaction local while the server renders usable thumbnails.
     */
}
<Panel as="section" class="recent-images" title="Recent images">
    {
        images.length > 0 ? (
            <recent-images-gallery class="recent-images__gallery">
                {/*
                 * Each figure keeps its caption visible in the grid. Only the
                 * image preview is interactive, so the description remains
                 * ordinary readable text rather than part of a button label.
                 */}
                <div
                    class="recent-images__grid"
                    data-image-count={images.length}
                >
                    {images.map((image, index) => {
                        const descriptionId = `recent-image-description-${index + 1}`;

                        return (
                            <figure class="recent-images__item">
                                <button
                                    class="recent-images__trigger"
                                    type="button"
                                    data-gallery-open
                                    data-image-src={image.expandedSrc}
                                    data-image-srcset={image.expandedSrcset}
                                    data-image-sizes={image.expandedSizes}
                                    data-image-width={image.expandedWidth}
                                    data-image-height={image.expandedHeight}
                                    data-image-alt={image.alt}
                                    data-image-description={image.description}
                                    aria-label={`Expand image: ${image.alt}`}
                                    aria-describedby={descriptionId}
                                    aria-haspopup="dialog"
                                >
                                    {/*
                                     * The source set covers the rendered
                                     * column at common display densities. The
                                     * intrinsic ratio keeps the masonry layout
                                     * stable before the image finishes loading.
                                     */}
                                    <Image
                                        class="recent-images__thumbnail"
                                        src={image.asset}
                                        alt={image.alt}
                                        widths={THUMBNAIL_WIDTHS}
                                        sizes={THUMBNAIL_SIZES}
                                        quality="max"
                                        loading="eager"
                                        decoding="async"
                                    />
                                </button>

                                <figcaption
                                    class="recent-images__description"
                                    id={descriptionId}
                                >
                                    {image.description}
                                </figcaption>
                            </figure>
                        );
                    })}
                </div>

                {/*
                 * A single dialog is reused for every thumbnail. The script
                 * decodes the browser-selected responsive candidate before
                 * opening the modal so the visible frame never starts empty.
                 */}
                <dialog
                    class="recent-images__dialog"
                    data-gallery-dialog
                    aria-label="Expanded gallery image"
                >
                    <button
                        class="recent-images__close"
                        type="button"
                        data-gallery-close
                        aria-label="Close expanded image"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
                        </svg>
                    </button>

                    <figure class="recent-images__figure">
                        <img
                            class="recent-images__expanded-image"
                            data-expanded-image
                            alt=""
                            decoding="async"
                        />
                        <figcaption
                            class="recent-images__expanded-description"
                            data-expanded-description
                        />
                    </figure>
                </dialog>
            </recent-images-gallery>
        ) : (
            <p class="recent-images__empty">No images available.</p>
        )
    }
</Panel>

<script>
    interface ExpandedImageData {
        src: string;
        srcset: string;
        sizes: string;
        alt: string;
        description: string;
        width: number;
        height: number;
    }

    /**
     * Adds dialog behavior to the server-rendered gallery without requiring a
     * framework or one listener per thumbnail.
     */
    class ImageGalleryElement extends HTMLElement {
        // Reuse in-flight and completed decode work when an image is reopened.
        private imageLoads = new Map<string, Promise<void>>();

        // A monotonically increasing token prevents stale async opens from
        // updating a dialog after a newer request or component disconnection.
        private openRequest = 0;

        /**
         * Reads and validates the responsive expanded-image values embedded in
         * a gallery button. Returning `null` prevents malformed markup from
         * opening a partially configured dialog.
         */
        private readImageData(
            openButton: HTMLButtonElement,
        ): ExpandedImageData | null {
            const src = openButton.dataset.imageSrc;
            const srcset = openButton.dataset.imageSrcset;
            const sizes = openButton.dataset.imageSizes;
            const alt = openButton.dataset.imageAlt;
            const description = openButton.dataset.imageDescription;
            const width = Number(openButton.dataset.imageWidth);
            const height = Number(openButton.dataset.imageHeight);

            if (
                !src ||
                !srcset ||
                !sizes ||
                !alt ||
                !description ||
                !Number.isFinite(width) ||
                !Number.isFinite(height) ||
                width <= 0 ||
                height <= 0
            ) {
                return null;
            }

            return {
                src,
                srcset,
                sizes,
                alt,
                description,
                width,
                height,
            };
        }

        /**
         * Loads and decodes the same responsive candidate that the visible
         * dialog will use. The complete source configuration forms the cache
         * key so different candidate sets cannot share stale decode work.
         */
        private preloadImage(imageData: ExpandedImageData): Promise<void> {
            const cacheKey = [
                imageData.src,
                imageData.srcset,
                imageData.sizes,
            ].join("|");

            const cachedLoad = this.imageLoads.get(cacheKey);

            if (cachedLoad) return cachedLoad;

            const preloader = new window.Image();

            preloader.decoding = "async";
            preloader.sizes = imageData.sizes;
            preloader.srcset = imageData.srcset;
            preloader.src = imageData.src;

            const imageLoad = preloader.decode();

            this.imageLoads.set(cacheKey, imageLoad);

            void imageLoad.catch(() => {
                this.imageLoads.delete(cacheKey);
            });

            return imageLoad;
        }

        /**
         * Preloads one selected image, updates the reusable dialog atomically,
         * and opens it only after decoding completes. The request token avoids
         * displaying a stale image if another action supersedes this click.
         */
        private async openImage(
            openButton: HTMLButtonElement,
            dialog: HTMLDialogElement,
        ): Promise<void> {
            const imageData = this.readImageData(openButton);
            const expandedImage = dialog.querySelector<HTMLImageElement>(
                "[data-expanded-image]",
            );
            const expandedDescription = dialog.querySelector<HTMLElement>(
                "[data-expanded-description]",
            );

            if (!imageData || !expandedImage || !expandedDescription) return;

            const request = ++this.openRequest;

            openButton.setAttribute("aria-busy", "true");

            try {
                await this.preloadImage(imageData);

                if (request !== this.openRequest || !this.isConnected) return;

                /*
                 * Assign responsive descriptors before `src`. This lets the
                 * browser select a sufficiently dense candidate for the first
                 * visible paint. Width and height preserve the aspect ratio.
                 */
                expandedImage.width = imageData.width;
                expandedImage.height = imageData.height;
                expandedImage.alt = imageData.alt;
                expandedImage.sizes = imageData.sizes;
                expandedImage.srcset = imageData.srcset;
                expandedImage.src = imageData.src;

                expandedDescription.textContent = imageData.description;

                /*
                 * The dialog is its own scroll container. Reset its position
                 * before every open so a previously viewed long caption cannot
                 * leave the next image above the visible area.
                 */
                dialog.scrollTop = 0;

                if (!dialog.open && dialog.isConnected) dialog.showModal();
            } catch (error) {
                // Keep the gallery usable if one generated asset is missing or
                // cannot be decoded, while retaining useful diagnostics.
                console.error("RecentImages could not open image.", error);
            } finally {
                openButton.removeAttribute("aria-busy");
            }
        }

        /**
         * Delegates clicks from the custom-element root. Thumbnail clicks
         * begin an asynchronous dialog open; close-button or outside-image
         * clicks dismiss the modal.
         *
         * This arrow property preserves the same function reference so the
         * listener can be removed when Astro disconnects the component.
         */
        private handleClick = (event: Event) => {
            const target = event.target;

            if (!(target instanceof Element)) return;

            const dialog = this.querySelector<HTMLDialogElement>(
                "[data-gallery-dialog]",
            );

            if (!dialog) return;

            const openButton = target.closest<HTMLButtonElement>(
                "[data-gallery-open]",
            );

            if (openButton) {
                void this.openImage(openButton, dialog);
                return;
            }

            if (target.closest("[data-gallery-close]")) {
                dialog.close();
                return;
            }

            /*
             * Native dialog backdrop clicks target the dialog itself. Limiting
             * dismissal to that case keeps the visible caption and close
             * control interactive inside the enlarged figure.
             */
            if (dialog.open && target === dialog) {
                dialog.close();
            }
        };

        /**
         * Invalidates any pending open after the dialog closes. The last
         * decoded image deliberately remains assigned: retaining one bounded
         * asset prevents a blank-image flash when it is reopened, and the next
         * image replaces it before the dialog becomes visible.
         */
        private handleClose = () => {
            this.openRequest += 1;
        };

        /**
         * Registers the gallery's delegated click listener and dialog cleanup
         * listener when the custom element enters the document.
         */
        connectedCallback() {
            const dialog = this.querySelector<HTMLDialogElement>(
                "[data-gallery-dialog]",
            );

            this.addEventListener("click", this.handleClick);
            dialog?.addEventListener("close", this.handleClose);
        }

        /**
         * Removes listeners when Astro navigation detaches the component,
         * avoiding duplicate handlers if the element is mounted again.
         */
        disconnectedCallback() {
            const dialog = this.querySelector<HTMLDialogElement>(
                "[data-gallery-dialog]",
            );

            this.removeEventListener("click", this.handleClick);
            dialog?.removeEventListener("close", this.handleClose);
            this.openRequest += 1;
            this.imageLoads.clear();
        }
    }

    // Guard registration because Astro can evaluate component scripts again
    // during client-side navigation.
    if (!customElements.get("recent-images-gallery")) {
        customElements.define("recent-images-gallery", ImageGalleryElement);
    }
</script>

<style>
    /*
     * Keep the shared Panel primitive generic while aligning this heading with
     * the content padding used throughout the homepage.
     */
    .recent-images > :global(.panel__heading) {
        padding: var(--space-md);
        border-bottom: var(--border-width) solid var(--border);
    }

    /*
     * The gallery deliberately stays narrower than the main column. Combined
     * with two masonry columns, --gallery-width produces cards close to the
     * requested 255px scale without stretching every image to fill the panel.
     */
    .recent-images__gallery {
        display: block;
        padding: var(--space-md);
    }

    /*
     * CSS columns preserve each image's natural aspect ratio and create the
     * compact Pinterest-like flow. Astro's intrinsic dimensions reserve each
     * thumbnail's space before its optimized file finishes loading.
     */
    .recent-images__grid {
        width: min(100%, var(--gallery-width));
        margin-inline: auto;
        column-count: 2;
        column-gap: var(--space-sm);
    }

    .recent-images__grid[data-image-count="1"] {
        width: min(
            100%,
            calc((var(--gallery-width) - var(--space-sm)) / 2)
        );
        column-count: 1;
    }

    /*
     * A figure owns the visual card and its caption. `inline-block` and
     * `break-inside` keep each pair together in the masonry flow.
     */
    .recent-images__item {
        display: inline-block;
        width: 100%;
        margin: 0 0 var(--space-sm);
        overflow: hidden;
        break-inside: avoid;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius);
        background: var(--card-bg);
        vertical-align: top;
    }

    .recent-images__item:hover,
    .recent-images__item:focus-within {
        border-color: var(--link-hover);
    }

    /*
     * Reset the shared button presentation because the trigger is an image
     * surface, not a native-style text control.
     */
    .recent-images__trigger {
        display: block;
        width: 100%;
        min-height: 0;
        padding: 0;
        overflow: hidden;
        border: 0;
        border-radius: 0;
        background: var(--surface-soft);
        box-shadow: none;
        color: inherit;
        cursor: zoom-in;
        line-height: 0;
        white-space: normal;
    }

    .recent-images__trigger:not(:disabled):hover,
    .recent-images__trigger:not(:disabled):active {
        background: var(--surface-soft);
        box-shadow: none;
        transform: none;
    }

    .recent-images__trigger[aria-busy="true"] {
        cursor: progress;
    }

    .recent-images__thumbnail {
        display: block;

        /*
     * Large sources shrink to the column, while a source narrower than the
     * column keeps its intrinsic width instead of being enlarged and blurred.
     */
        width: auto;
        max-width: 100%;
        height: auto;
        margin-inline: auto;
        background: var(--surface-soft);
        image-rendering: auto;
    }

    .recent-images__description {
        display: block;
        padding: var(--space-sm) var(--space-md);
        border-top: var(--border-width) solid var(--border);
        background: var(--card-bg);
        color: var(--text-muted);
        font-size: var(--font-xs);
        line-height: 1.45;
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    .recent-images__trigger:focus-visible {
        outline: 2px solid var(--link-hover);
        outline-offset: -2px;
    }

    /*
     * The dialog is transparent so the figure supplies the visible frame.
     * The script provides intrinsic dimensions before opening, while these
     * viewport limits and internal scrolling keep both the image and an
     * arbitrarily long caption reachable without leaving the viewport.
     */
    .recent-images__dialog {
        width: fit-content;
        max-width: 94vw;
        max-height: 92vh;
        max-height: 92dvh;
        margin: auto;
        padding: 0;
        overflow: auto;
        overscroll-behavior: contain;
        border: 0;
        background: transparent;
        color: var(--text-main);
    }

    .recent-images__dialog::backdrop {
        background: color-mix(in srgb, var(--page-bg) 88%, transparent);
    }

    .recent-images__figure {
        display: grid;
        margin: 0;
        overflow: hidden;
        border: var(--border-width) solid var(--border-strong);
        border-radius: var(--radius);
        background: var(--page-shell);
        box-shadow: var(--shadow);
    }

    .recent-images__expanded-image {
        display: block;

        /*
         * The inline-size cap leaves room for a high-density source candidate
         * while `width: auto` prevents a small original from being enlarged
         * beyond its intrinsic dimensions.
         */
        width: auto;
        max-width: min(92vw, var(--shell-max-width));
        height: auto;
        max-height: 80vh;
        max-height: 80dvh;

        object-fit: contain;
        image-rendering: auto;
        justify-self: center;
    }

    .recent-images__expanded-description {
        padding: var(--space-sm) var(--space-md);
        border-top: var(--border-width) solid var(--border);
        background: var(--card-bg);
        color: var(--text-main);
        font-size: var(--font-xs);
        line-height: 1.45;
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    .recent-images__close {
        position: fixed;
        z-index: 1;
        inset-block-start: var(--space-md);
        inset-inline-end: var(--space-md);
        display: grid;
        width: calc(var(--space-xl) + var(--space-sm));
        height: calc(var(--space-xl) + var(--space-sm));
        place-items: center;
        padding: 0;
        border: var(--border-width) solid var(--border-strong);
        border-radius: 50%;
        background: color-mix(in srgb, var(--page-shell) 78%, transparent);
        box-shadow: none;
        color: var(--text-strong);
        font-size: var(--font-xl);
        line-height: 1;
        cursor: pointer;
    }

    .recent-images__close:hover,
    .recent-images__close:focus-visible {
        border-color: var(--link-hover);
        background: var(--surface-hover);
        color: var(--link-hover);
    }

    .recent-images__close:focus-visible {
        outline: 2px solid var(--link-hover);
        outline-offset: 2px;
    }

    .recent-images__empty {
        margin: 0;
        padding: var(--space-md);
        color: var(--text-muted);
        font-size: var(--font-sm);
        line-height: 1.45;
    }

    /* Tighten the panel body before collapsing the gallery to one column. */
    @media (max-width: 38rem) {
        .recent-images__gallery {
            padding: var(--space-sm);
        }
    }

    /* Very narrow screens display a single full-width preview column. */
    @media (max-width: 25rem) {
        .recent-images__grid,
        .recent-images__grid[data-image-count="1"] {
            width: 100%;
            column-count: 1;
        }
    }
</style>