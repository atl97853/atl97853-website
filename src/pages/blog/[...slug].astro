---
/**
 * Renders one Markdown entry from the blog collection.
 *
 * BaseLayout provides the document shell. Panel provides the shared surface,
 * while this page owns the post header and Markdown presentation.
 */

import BaseLayout from "@layouts/BaseLayout.astro";

import Panel from "@components/primitives/Panel.astro";

import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

import { formatDate } from "../../utils";

export async function getStaticPaths() {
    const posts = await getCollection("blog");

    /*
     * Each collection entry becomes one static route. The entry itself is
     * passed as a prop so the page can access its frontmatter and body.
     */
    return posts.map((entry) => ({
        params: {
            slug: entry.id,
        },
        props: {
            entry,
        },
    }));
}

interface Props {
    entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;

/*
 * `entry.data` contains the validated Markdown frontmatter.
 * `render(entry)` converts the Markdown body into an Astro component.
 */
const { Content } = await render(entry);

const {
    title: postTitle,
    pubDate,
} = entry.data;

const publishedDateTime = pubDate.toISOString();
const publishedDateLabel = formatDate(pubDate);
---

<BaseLayout
    title={postTitle}
    description={postTitle}
>
    <Panel
        as="article"
        class="blog-post"
    >
        <header class="blog-post__header">
            <h1 class="blog-post__title">
                {postTitle}
            </h1>

            <div class="blog-post__meta">
                <time
                    class="blog-post__date"
                    datetime={publishedDateTime}
                >
                    {publishedDateLabel}
                </time>

                {/*
                 * Future tags can be added to this metadata row without
                 * changing the Markdown content structure.
                 */}
            </div>
        </header>

        <div class="blog-post__content">
            <Content />
        </div>
    </Panel>
</BaseLayout>

<style>
    /* Scoped Panel override.
     * Panel owns the shared border, background, radius, and shadow.
     * This page removes its padding so the header and body can control
     * their spacing independently.
     */
    .blog-post {
        width: 100%;
        min-width: 0;
        max-width: 100%;
    }
    /* Scoped Panel override */

    .blog-post__header {
        /* padding: var(--space-sm); */
        padding: 0.82rem var(--space-md);
        border-bottom: 1px solid var(--border);
    }

    .blog-post__title {
        margin: 0;
        color: var(--text-strong);
        font-size: var(--font-md);
        font-weight: var(--fw-semibold);
        line-height: var(--line-height-reading);
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    .blog-post__meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-xs) var(--space-sm);
        margin-top: var(--space-xs);
    }

    .blog-post__date {
        color: var(--text-muted);
        font-size: var(--font-sm);
        font-variant-numeric: tabular-nums;
        line-height: var(--line-height-reading);
    }

    /*
     * Content renders Markdown as generated HTML. The local
     * blog-post__content selector keeps the global element rules bounded
     * to this article.
     */
    .blog-post__content {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        /* padding: var(--space-sm); */
        padding: 0.82rem var(--space-md);
        color: var(--text-main);
        font-size: var(--font-md);
        /*
         * !!! Core reading rhythm.
         * This controls spacing between lines within the same paragraph.
         */
        /* line-height: 1.55; */
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .blog-post__content > :global(*:first-child) {
        margin-top: 0;
    }

    .blog-post__content > :global(*:last-child) {
        margin-bottom: 0;
    }

    /*
     * !!! Core paragraph rhythm.
     * Blank lines in Markdown create separate <p> elements, and this margin
     * creates the visible space between those paragraphs.
     */
    .blog-post__content :global(p) {
        margin-top: 0;
        margin-bottom: var(--space-md);
        text-wrap: pretty;
    }

    /*
     * The frontmatter title is the post's primary h1. Markdown content
     * should generally begin with an h2.
     */
    .blog-post__content :global(h1),
    .blog-post__content :global(h2),
    .blog-post__content :global(h3),
    .blog-post__content :global(h4),
    .blog-post__content :global(h5),
    .blog-post__content :global(h6) {
        color: var(--text-strong);
        font-weight: var(--fw-semibold);
        line-height: 1.3;
        overflow-wrap: anywhere;
        text-wrap: pretty;
    }

    .blog-post__content :global(h1),
    .blog-post__content :global(h2) {
        margin: var(--space-lg) 0 var(--space-sm);
        padding-bottom: var(--space-xs);
        font-size: var(--font-md);
        border-bottom: 1px solid var(--border);
    }

    .blog-post__content :global(h3) {
        margin: var(--space-md) 0 var(--space-xs);
        font-size: var(--font-md);
    }

    .blog-post__content :global(h4),
    .blog-post__content :global(h5),
    .blog-post__content :global(h6) {
        margin: var(--space-md) 0 var(--space-xs);
        font-size: var(--font-sm);
    }

    .blog-post__content :global(a) {
        color: var(--link-main);
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
    }

    .blog-post__content :global(a:hover),
    .blog-post__content :global(a:focus-visible) {
        text-decoration-thickness: 2px;
    }

    .blog-post__content :global(a:focus-visible) {
        outline: 2px solid var(--link-main);
        outline-offset: 2px;
    }

    .blog-post__content :global(ul),
    .blog-post__content :global(ol) {
        margin-top: 0;
        margin-bottom: var(--space-md);
        padding-inline-start: 1.2rem;
    }

    .blog-post__content :global(ul) {
        list-style: disc;
    }

    .blog-post__content :global(ol) {
        list-style: decimal;
    }

    .blog-post__content :global(li + li) {
        margin-top: 0.2rem;
    }

    .blog-post__content :global(li > ul),
    .blog-post__content :global(li > ol) {
        margin-top: var(--space-xs);
        margin-bottom: 0;
    }

    .blog-post__content :global(blockquote) {
        margin: var(--space-md) 0;
        padding-inline-start: var(--space-sm);
        color: var(--text-muted);
        border-inline-start: 2px solid var(--border);
    }

    .blog-post__content :global(blockquote > *:last-child) {
        margin-bottom: 0;
    }

    .blog-post__content :global(img) {
        display: block;
        box-sizing: border-box;
        max-width: 100%;
        height: auto;
        margin: var(--space-md) auto;
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .blog-post__content :global(figure) {
        margin: var(--space-md) 0;
    }

    .blog-post__content :global(figure img) {
        margin-block: 0;
    }

    .blog-post__content :global(figcaption) {
        margin-top: var(--space-xs);
        color: var(--text-muted);
        font-size: var(--font-sm);
        line-height: var(--line-height-reading);
    }

    /*
     * Responsive embeds use their available column width. The aspect ratio
     * gives iframe-based media a stable height when the source omits one.
     */
    .blog-post__content :global(iframe),
    .blog-post__content :global(video),
    .blog-post__content :global(embed),
    .blog-post__content :global(object) {
        width: 100%;
        max-width: 100%;
    }

    .blog-post__content :global(iframe) {
        aspect-ratio: 16 / 9;
        height: auto;
    }

    /* Inline code receives a compact visual treatment within prose. */
    .blog-post__content :global(code) {
        padding: 0.1rem 0.3rem;
        overflow-wrap: anywhere;
        word-break: break-word;
        color: var(--text-strong);
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-family:
            var(
                --font-mono,
                ui-monospace,
                SFMono-Regular,
                Consolas,
                "Liberation Mono",
                monospace
            );
        font-size: 0.9em;
        font-variant-ligatures: none;
    }

    /*
     * Fenced code and text blocks preserve whitespace, allowing the same
     * element to display source code and simple ASCII art.
     */
    .blog-post__content :global(pre) {
        box-sizing: border-box;
        max-width: 100%;
        margin: var(--space-md) 0;
        padding: var(--space-md);
        overflow-x: auto;
        overflow-wrap: normal;
        color: var(--text-main);
        background: var(--surface-hover);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        tab-size: 4;
        white-space: pre;
        -webkit-overflow-scrolling: touch;
    }

    /*
     * Reset the inline-code appearance when code is nested inside a fenced
     * block. The surrounding <pre> owns the block surface.
     */
    .blog-post__content :global(pre code) {
        display: block;
        min-width: max-content;
        padding: 0;
        color: inherit;
        background: transparent;
        border: 0;
        border-radius: 0;
        font-size: var(--font-sm);
        line-height: 1.6;
        overflow-wrap: normal;
        word-break: normal;
        white-space: inherit;
    }

    .blog-post__content :global(table) {
        display: block;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        margin: var(--space-md) 0;
        overflow-x: auto;
        border-collapse: collapse;
        -webkit-overflow-scrolling: touch;
    }

    .blog-post__content :global(th),
    .blog-post__content :global(td) {
        padding: var(--space-xs) var(--space-sm);
        border: 1px solid var(--border);
        text-align: start;
        vertical-align: top;
    }

    .blog-post__content :global(th) {
        color: var(--text-strong);
        font-weight: var(--fw-semibold);
        background: var(--surface-hover);
    }

    .blog-post__content :global(hr) {
        height: 0;
        margin: var(--space-lg) 0;
        border: 0;
        border-top: 1px solid var(--border);
    }

    .blog-post__content :global(.katex-display),
    .blog-post__content :global(.math-display),
    .blog-post__content :global(mjx-container[display="true"]) {
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        padding-block: var(--space-xs);
        -webkit-overflow-scrolling: touch;
    }

    @media (max-width: 38rem) {
        .blog-post__header,
        .blog-post__content {
            padding-inline: var(--space-sm);
        }

        .blog-post__content :global(ul),
        .blog-post__content :global(ol) {
            padding-inline-start: 1.1rem;
        }

        .blog-post__content :global(pre) {
            padding: var(--space-sm);
        }

        .blog-post__content :global(th),
        .blog-post__content :global(td) {
            padding: var(--space-xs);
        }
    }

    @media print {
        .blog-post {
            color: #111;
            background: transparent;
            border: 0;
            box-shadow: none;
        }

        .blog-post__content :global(a) {
            color: #000;
        }
    }
</style>