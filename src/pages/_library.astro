---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";

import BookEntry from "@components/library/BookEntry.astro";
import LibraryYearNav from "@components/library/LibraryYearNav.astro";
import Card from "@components/primitives/Card.astro";

const books: CollectionEntry<"library">[] = (await getCollection("library")).sort(
    (a, b) =>
        b.data.readYear - a.data.readYear ||
        a.data.title.localeCompare(b.data.title)
);

const booksByYear = new Map<number, CollectionEntry<"library">[]>();

for (const book of books) {
    const year = book.data.readYear;
    const yearBooks = booksByYear.get(year) ?? [];

    yearBooks.push(book);
    booksByYear.set(year, yearBooks);
}

const yearGroups = [...booksByYear.entries()]
    .sort(([yearA], [yearB]) => yearB - yearA)
    .map(([year, books]) => ({
        year,
        books,
    }));

const years = yearGroups.map((group) => group.year);

const tags = [
    ...new Set(
        books.flatMap((book) =>
            (book.data.tags ?? [])
                .map((tag) => tag.trim())
                .filter(Boolean)
        )
    ),
].sort((a, b) => a.localeCompare(b));

const totalBooks = books.length;
const bookCountLabel = totalBooks === 1 ? "1 book" : `${totalBooks} books`;
---

<BaseLayout tabTitle="library">
    <Card
        slot="custom-cards"
        as="article"
        title="Library"
        titleId="library-title"
        class="c-library-page"
        bodyClass="c-library-page__body"
    >
        <p class="c-library-page__intro">
            {bookCountLabel} in my personal reading archive.
        </p>

        {
            tags.length > 0 && (
                <ul class="c-library-page__tags" aria-label="Library tags">
                    {tags.map((tag) => (
                        <li class="c-library-page__tag">{tag}</li>
                    ))}
                </ul>
            )
        }

        {
            yearGroups.length > 0 ? (
                <div class="c-library-page__content">
                    {yearGroups.map(({ year, books }) => (
                        <section
                            id={`library-${year}`}
                            class="c-library-year"
                            aria-labelledby={`library-${year}-title`}
                        >
                            <h2
                                id={`library-${year}-title`}
                                class="c-library-year__title"
                            >
                                {year}
                            </h2>

                            <div class="c-library-list">
                                {books.map((book) => (
                                    <BookEntry book={book} />
                                ))}
                            </div>
                        </section>
                    ))}
                </div>
            ) : (
                <p class="c-library-page__empty">
                    No books have been added yet.
                </p>
            )
        }
    </Card>

    <LibraryYearNav years={years} slot="custom-cards-aside" />
</BaseLayout>

<style>
    :global(.c-library-page) {
        --library-border: rgba(0, 0, 0, 0.14);
        --library-tag-bg: rgba(0, 0, 0, 0.04);
        --library-star: #b8860b;

        color: var(--clr-text-main);
    }

    :global([theme="dark"] .c-library-page) {
        --library-border: rgba(255, 255, 255, 0.16);
        --library-tag-bg: rgba(255, 255, 255, 0.08);
        --library-star: #d6d6d6;
    }

    .c-library-page__intro {
        max-width: 58ch;
        margin: 0;
        color: var(--clr-text-main);
        font-size: var(--fs-sm);
        line-height: 1.5;
    }

    .c-library-page__tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin: var(--space-sm) 0 0;
        padding: 0;
        list-style: none;
    }

    .c-library-page__tag {
        padding: 0.1rem 0.45rem;
        color: var(--clr-text-main);
        background: var(--library-tag-bg);
        border: var(--bw-frame) solid var(--library-border);
        font-size: var(--fs-xs);
        line-height: 1.35;
    }

    .c-library-page__content {
        margin-top: var(--space-lg);
    }

    .c-library-year {
        scroll-margin-top: var(--space-lg);
    }

    .c-library-year + .c-library-year {
        margin-top: var(--space-xl);
    }

    .c-library-year__title {
        margin: 0 0 var(--space-sm);
        color: var(--clr-text-main);
        font-size: var(--fs-sm);
        line-height: 1.35;
        font-weight: 700;
        overflow-wrap: break-word;
    }

    .c-library-list {
        border-top: var(--bw-frame) solid var(--library-border);
    }

    .c-library-page__empty {
        margin: var(--space-lg) 0 0;
        color: var(--clr-text-muted);
        font-size: var(--fs-sm);
        line-height: 1.5;
    }
</style>