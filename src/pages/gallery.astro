---
import BaseLayout from "@layouts/BaseLayout.astro";

import SiteNavigation from "@components/layout/SiteNavigation.astro";
import MusicPlayer from "@components/layout/MusicPlayer.astro";
import HomeIntro from "@components/homepage/HomeIntro.astro";
import ImageGallery from "@components/homepage/ImageGallery.astro";

const tabTitle = "Gallery";
const metaDescription = "Hello, my name is Atl, and this is my personal website. Here I write about my studies, technology, books I have read, and other things I find interesting. Feel free to wander around.";
---

<BaseLayout
    title={tabTitle}
    description={metaDescription}
>
    <ImageGallery />

    <Fragment slot="toolbar">
        <nav class="home-toolbar" aria-label="Breadcrumb">
            <p class="home-toolbar__crumbs">
                <a href="/">atl97853</a>
                <span aria-hidden="true">/</span>
                <span aria-current="page">home</span>
            </p>
            <span class="home-toolbar__note">personal webspace · notes &amp; snapshots</span>
        </nav>
    </Fragment>

    <Fragment slot="sidebar">
        <HomeIntro />
        <SiteNavigation />
        <MusicPlayer />
    </Fragment>
</BaseLayout>

<style>
    .home-toolbar {
        display: flex;
        min-width: 0;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        padding: 0.55rem var(--space-md);
        color: var(--text-muted);
        font-size: var(--font-xs);
    }

    .home-toolbar__crumbs {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        min-width: 0;
        margin: 0;
        color: var(--text-strong);
        font-family: var(--font-mono);
        font-size: var(--font-xs);
        font-weight: var(--fw-semibold);
    }

    .home-toolbar__crumbs a {
        color: var(--link-main);
        text-decoration: none;
    }

    .home-toolbar__note {
        font-family: var(--font-mono);
        font-size: var(--font-2xs);
        text-align: end;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    @media (max-width: 32rem) {
        .home-toolbar__note {
            display: none;
        }
    }
</style>